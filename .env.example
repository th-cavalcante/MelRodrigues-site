# Configurações da Aplicação MR Laser Concept

# URLs e Endpoints
REACT_APP_API_URL=http://localhost:3001
REACT_APP_SITE_URL=http://localhost:3000

# Supabase (Para futuras integrações de backend)
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_KEY=your_supabase_key_here

# WhatsApp (Número para botões de contato)
REACT_APP_WHATSAPP_NUMBER=5511987654321

# Analytics (Para futuro)
REACT_APP_GA_ID=your_google_analytics_id_here

# Email Service (Para futuro)
REACT_APP_EMAIL_SERVICE=emailjs
REACT_APP_EMAIL_SERVICE_ID=your_service_id_here
REACT_APP_EMAIL_TEMPLATE_ID=your_template_id_here

# Ambiente
REACT_APP_ENV=development
